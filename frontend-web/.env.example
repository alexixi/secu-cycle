# Base URL of API, use http://127.0.0.1 for local development
# The port must be included in the URL
VITE_API_BASE_URL=http://127.0.0.1:8000

VITE_MAPTILER_KEY=your_api_key_here
# Get an free API key at https://www.maptiler.com/cloud/

# Umami analytics: ID du site (Umami > Settings > Websites). Valeur publique, pas un secret.
# Laisser vide désactive de fait le tracking (aucun website-id valide).
VITE_UMAMI_WEBSITE_ID=
