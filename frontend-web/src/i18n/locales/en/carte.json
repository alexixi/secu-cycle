        "meteoModal": {
            "h2": "Weather",
            "niveauxVigilance": "Warning levels",
            "releve": "The reading is taken at <b>a single point in the city centre</b>, and the bar shows the highest warning level in force. This is a <b>regional</b> level: a storm cell is 5 to 15 km across and we only sample one point. Hence “risk of storms”, never “storm on your route”.",
            "avertissement": "So we say “<b>risk</b> of storms”, never “storm on your route”. Weather <b>does not influence</b> route planning: it informs you, it will not send you on a detour based on a forecast at this resolution.",
            "pluie30": "Rain in the next 30 minutes",
            "pluie30Texte": "The <b>15-minute</b> forecast comes from the high-resolution models <b>AROME</b> (Météo-France) and<b> ICON-D2</b> (DWD). Outside their coverage it is not shown at all, rather than being quietly interpolated from the hourly forecast.",
            "sources": "Sources",
            "sourcesTexte": "Forecasts: <b>Open-Meteo</b> (DWD ICON-D2, Météo-France AROME, NOAA GFS).",
            "niveaux": {
                "none": "Nothing to report",
                "noneDetail": "Ordinary conditions",
                "watch": "Caution",
                "watchDetail": "Gusts ≥ 40 km/h, rain, cold, fog",
                "warning": "Difficult conditions",
                "warningDetail": "Storms, snow, heavy rain, frost",
                "severe": "Danger",
                "severeDetail": "Black ice, hail, gusts ≥ 80 km/h"
            },
            "ventPonts": "<b>Wind</b> adjusts the <em>displayed</em> duration of the route, never the route itself. Below 3 °C, <b>bridges</b> of 30 m or more are flagged: a deck loses heat from both sides and freezes one to two hours before the road beside it."
        },
        "airModal": {
            "h2": "Air quality",
            "cellules": "Cells — European index (CAMS)",
            "cellulesTexte": "European index (<b>EAQI</b>) from the Copernicus service (<b>CAMS</b>). Each cell is roughly <b>{{resolution}} km</b>: a regional level, not a street-level measurement.",
            "cellulesAvertissement": "Two neighbouring streets therefore share the same index. For routing we favour streets<b> away from traffic</b> (inferred from the road network), not the cell. Good air = criterion inactive.",
            "pastilles": "Dots — ground sensors",
            "pastillesTexte": "The <b>dots</b> are <b>real stations</b>. A model can lag behind a recent fire; a station <b>measures</b> it without delay. A nearby spike then weighs on the route.",
