{
  "name": "pfa",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "prebuild": "node scripts/generate-seo.mjs",
    "build": "vite build",
    "postbuild": "react-snap && node scripts/verify-prerender.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "check-coverage": "node scripts/check-coverage.mjs"
  },
  "reactSnap": {
    "source": "dist",
    "//": "react-snap suit aussi les liens internes : /carte suffit à faire découvrir les hubs de ville puis les cartes thématiques.",
    "include": ["/", "/itineraire", "/login", "/signin", "/mentions-legales", "/confidentialite", "/conditions-utilisation", "/contact", "/faq", "/donnees", "/carte"],
    "inlineCss": false,
    "skipThirdPartyRequests": true,
    "puppeteerArgs": ["--no-sandbox", "--disable-setuid-sandbox"]
  },
  "dependencies": {
    "canvas-confetti": "^1.9.4",
    "maplibre-gl": "^5.22.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-helmet-async": "^3.0.0",
    "react-icons": "^5.5.0",
    "react-map-gl": "^8.1.0",
    "react-router": "^8.3.0",
    "recharts": "^3.8.1"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "react-snap": "^1.23.0",
    "vite": "npm:rolldown-vite@7.2.5",
    "vite-plugin-svgr": "^4.5.0"
  },
  "overrides": {
    "ajv": "^8.18.0",
    "minimatch": "^10.2.1",
    "vite": "npm:rolldown-vite@7.2.5"
  }
}
