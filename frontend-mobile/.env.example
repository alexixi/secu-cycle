EXPO_PUBLIC_MAPTILER_KEY=your_api_key_here
# Get an free API key at https://www.maptiler.com/cloud/

EXPO_PUBLIC_API_URL=your_api_base_url_here
EXPO_PUBLIC_API_PORT=your_api_port_here

EXPO_PUBLIC_APTABASE_KEY=your_aptabase_app_key_here
# Get a free app key at https://aptabase.com (analytics disabled if empty)
EXPO_PUBLIC_APTABASE_HOST=
# Only for a self-hosted Aptabase instance, leave empty for Aptabase Cloud
