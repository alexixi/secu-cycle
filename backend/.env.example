# PostgreSQL database configuration
POSTGRES_DB=db_name
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# Clé secrète de signature des JWT. À générer avec : openssl rand -hex 32
SECRET_KEY=your_secret_key_here

# CORS_ORIGINS should be a comma-separated list of allowed origins for CORS requests.
# For local development, you can set it to something like:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Resend (envoi d'e-mails). Générer une clé sur https://resend.com et vérifier
# le domaine d'envoi. Sans clé, les mails sont logués en console (mode dev).
RESEND_API_KEY=
RESEND_FROM_EMAIL=SecuCycle <noreply@secu-cycle.fr>

# Boîte qui reçoit les messages du formulaire de contact.
# Défaut : contact@secu-cycle.fr
CONTACT_EMAIL=

# Administrateurs du dashboard admin, liste d'e-mails séparés par des virgules.
# Un compte dont l'e-mail figure ici est admin sans avoir à modifier la base
# (en plus des comptes portant le flag is_admin=true en base). Laisser vide
# pour n'accorder les droits qu'via le flag en base.
ADMIN_EMAILS=

# Les profils de graphe sont administrés depuis le dashboard (table
# `graph_profiles`) : c'est le profil marqué « par défaut » qui est chargé.
# GRAPH_PROFILE ne sert plus que d'amorçage, si aucun profil n'est marqué par
# défaut. La laisser vide.
GRAPH_PROFILE=

# Expose la documentation interactive de l'API (/docs, /redoc, /openapi.json).
# Mettre à 1/true UNIQUEMENT en développement. Laisser vide en production pour ne
# pas divulguer le schéma complet des endpoints (docker-compose.override.yml la met
# à 1 en local).
ENABLE_DOCS=

# MapTiler (https://www.maptiler.com/) : clé d'API pour le géocodage.
# Générez une clé sur https://cloud.maptiler.com/account
MAPTILER_KEY=
MAPTILER_GEOCODING_BUDGET=

# WAQI / World Air Quality Index : jeton pour les stations de mesure au sol
# (pastilles de qualité de l'air, complément du modèle CAMS). Optionnel — si vide,
# la couche air reste affichée en cellules CAMS seules, sans capteurs.
# Jeton gratuit : https://aqicn.org/data-platform/token
WAQI_TOKEN=
# Vélos en libre-service (GBFS) : mettre à 0 pour masquer la couche sans
# redéployer. L'endpoint /bikeshare/ répond alors une collection vide.
BIKESHARE_ENABLED=1
# Clé d'accès aux flux temps réel de Bordeaux Métropole (Le Vélo / VCub). Publique,
# distribuée en clair par leur portail open data, et déjà renseignée par défaut
# dans le code : à ne surcharger que si la métropole la fait tourner.
BIKESHARE_TBM_API_KEY=
# Météo (Open-Meteo) : mettre à 0 pour masquer la couche sans redéployer.
# L'endpoint /weather/ répond alors `available: false` et aucune requête ne sort.
WEATHER_ENABLED=1
# L'offre gratuite d'Open-Meteo NE DEMANDE AUCUNE CLÉ, mais elle est réservée à un
# usage NON COMMERCIAL (10 000 appels/jour ; nous en consommons ~4 300). Ces deux
# variables sont l'issue de secours le jour où l'usage cesserait de l'être, ou
# pour pointer vers une instance Open-Meteo auto-hébergée. Laisser vide sinon.
OPEN_METEO_URL=
OPEN_METEO_API_KEY=
# Durée de conservation d'un résultat de géocodage en cache, en jours. Long par
# défaut (365) : une adresse ne bouge pas, et chaque entrée réutilisée est un
# appel MapTiler évité. Baisser si l'on veut rafraîchir plus souvent.
GEOCODE_CACHE_TTL_DAYS=

# Taille du cache de résultats d'itinéraire (nombre d'itinéraires mémorisés).
# Les requêtes répétées à l'identique deviennent alors quasi instantanées.
# Défaut : 256 (~10-15 Mo). Mettre 0 pour désactiver le cache.
ROUTE_CACHE_SIZE=256
