# PostgreSQL database configuration
POSTGRES_DB=db_name
POSTGRES_USER=user
POSTGRES_PASSWORD=password

# Clé secrète de signature des JWT. À générer avec : openssl rand -hex 32
# Ne JAMAIS commiter sa vraie valeur.
SECRET_KEY=your_secret_key_here

# CORS_ORIGINS should be a comma-separated list of allowed origins for CORS requests.
# For local development, you can set it to something like:
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:5174,http://127.0.0.1:5174

# Resend (envoi d'e-mails). Générer une clé sur https://resend.com et vérifier
# le domaine d'envoi. Sans clé, les mails sont logués en console (mode dev).
RESEND_API_KEY=
RESEND_FROM_EMAIL=SecuCycle <noreply@secu-cycle.fr>

# Boîte qui reçoit les messages du formulaire de contact.
# Défaut : contact@secu-cycle.fr
CONTACT_EMAIL=

# Administrateurs du dashboard admin, liste d'e-mails séparés par des virgules.
# Un compte dont l'e-mail figure ici est admin sans avoir à modifier la base
# (en plus des comptes portant le flag is_admin=true en base). Laisser vide
# pour n'accorder les droits qu'via le flag en base.
ADMIN_EMAILS=

# Profil de graphe routier à charger, défini dans backend/graphs.json.
# Laisser vide pour utiliser le "default_profile" du fichier de config.
# (Optionnel) GRAPH_CONFIG permet de pointer un autre fichier de config.
GRAPH_PROFILE=
# GRAPH_CONFIG=graphs.json

# Taille du cache de résultats d'itinéraire (nombre d'itinéraires mémorisés).
# Les requêtes répétées à l'identique deviennent alors quasi instantanées.
# Défaut : 256 (~10-15 Mo). Mettre 0 pour désactiver le cache.
ROUTE_CACHE_SIZE=256
